// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  avatar        String?
  emailVerified DateTime?
  verifyToken   String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联应用
  apps          App[]

  @@map("users")
}

model App {
  id          String      @id @default(cuid())
  name        String
  description String?
  icon        String      @default("🤖")
  type        AppType     @default(WORKFLOW)
  tags        String[]    @default([])
  config      Json?       // 应用配置（工作流定义等）
  version     Int         @default(1)
  isPublished Boolean     @default(false)
  isDeleted   Boolean     @default(false)

  // 发布相关字段
  publishedWorkflowId  String?   // 发布的工作流版本 ID

  // 关联 API Keys（一个应用可以有多个 API Key）
  apiKeys     ApiKey[]

  // 关联用户
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 关联工作流（一个应用可以有多个工作流版本）
  workflows   Workflow[]

  // 关联发布的工作流版本
  publishedWorkflow     Workflow? @relation("PublishedWorkflow", fields: [publishedWorkflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // 关联执行历史
  executions  WorkflowExecution[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  publishedAt DateTime?

  @@index([userId])
  @@index([type])
  @@map("apps")
}

model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?

  // 工作流定义（节点、边、配置）
  nodes       Json     // 节点数据
  edges       Json     // 边数据

  // 版本控制
  version     Int      @default(1)
  isPublished Boolean  @default(false)

  // 关联应用
  appId       String
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  // 反向关联（被 App.publishedWorkflow 引用）
  appPublishes App[]       @relation("PublishedWorkflow")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?

  @@index([appId])
  @@index([version])
  @@map("workflows")
}

// 工作流执行历史记录
model WorkflowExecution {
  id           String              @id @default(cuid())
  executionId  String              @unique // 执行唯一标识

  // 执行状态
  status       ExecutionStatus     @default(RUNNING)

  // 输入输出
  inputs       Json?               // 输入参数
  outputs      Json?               // 输出结果
  error        String?             // 错误信息

  // 执行统计
  duration     Int?                // 执行耗时(毫秒)
  totalTokens  Int                 @default(0) // Token消耗

  // 节点执行追踪
  nodeTraces   Json?               // 节点执行详情

  // 关联应用
  appId        String
  app          App                 @relation(fields: [appId], references: [id], onDelete: Cascade)

  // 执行时间
  startedAt    DateTime            @default(now())
  completedAt  DateTime?

  @@index([appId])
  @@index([status])
  @@index([startedAt])
  @@map("workflow_executions")
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  ERROR
}

enum AppType {
  WORKFLOW
  CHATBOT
  AGENT
}

// API 访问密钥
model ApiKey {
  id          String    @id @default(cuid())
  name        String                          // Key 名称（便于识别）
  key         String    @unique               // 实际的 API Key 值
  keyPrefix   String                          // Key 前缀（用于显示 sk-xxx...xxx）

  // 状态和权限
  isActive    Boolean   @default(true)        // 是否启用
  expiresAt   DateTime?                       // 过期时间（null 表示永不过期）

  // 使用统计
  lastUsedAt  DateTime?                       // 最后使用时间
  usageCount  Int       @default(0)           // 使用次数

  // 关联应用
  appId       String
  app         App       @relation(fields: [appId], references: [id], onDelete: Cascade)

  // 时间戳
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([appId])
  @@index([key])
  @@map("api_keys")
}
