// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  avatar        String?
  emailVerified DateTime?
  verifyToken   String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联应用
  apps App[]

  @@map("users")
}

enum AppType {
  WORKFLOW
  CHATBOT
  AGENT
}

model App {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String   @default("🤖")
  type        AppType  @default(WORKFLOW)
  tags        String[] @default([])
  config      Json?
  version     Int      @default(1)
  isPublic    Boolean  @default(false)
  isDeleted   Boolean  @default(false)

  // 关联用户
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  // 关联工作流（一个应用可以有多个工作流版本）
  workflows Workflow[]

  // 关联执行历史
  executions WorkflowExecution[]

  @@index([userId])
  @@index([type])
  @@map("apps")
}

model Workflow {
  id          String  @id @default(cuid())
  name        String
  description String?

  // 工作流定义（节点、边、配置）
  nodes Json
  edges Json

  // 版本控制
  version     Int     @default(1)
  isPublished Boolean @default(false)

  // 关联应用
  appId String
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([appId])
  @@index([version])
  @@map("workflows")
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  ERROR
}

// 工作流执行历史记录
model WorkflowExecution {
  id          String @id @default(cuid())
  executionId String @unique // 执行唯一标识

  // 执行状态
  status ExecutionStatus @default(RUNNING)

  // 输入输出
  inputs  Json? // 工作流输入参数
  outputs Json? // 工作流输出结果
  error   String? // 错误信息

  // 执行统计
  duration    Int? // 执行时长，单位毫秒
  totalTokens Int  @default(0) // 总消耗 tokens 数

  // 节点执行追踪
  nodeTraces Json? // 节点执行详情，包括每个节点的输入输出、执行时长、消耗 tokens 数等

  // 关联应用
  appId String
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  // 执行时间
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([appId])
  @@index([status])
  @@index([startedAt])
  @@map("workflow_executions")
}
